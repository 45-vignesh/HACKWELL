# MediSentinel Configuration
PROJECT_NAME="MediSentinel - Agentic AI for Hospital Inventory"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL with automatic SQLite fallback)
# If PostgreSQL is configured: postgresql+psycopg://postgres:password@localhost:5432/medisentinel
# Default fallback: sqlite:///./medisentinel.db
DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/medisentinel"

# Dataset Configuration (MIMIC-IV Clinical Database Demo)
MIMIC_DATA_DIR="D:/hackwell/datasets/mimic-iv-clinical-database-demo-2.2/hosp"

# LLM Provider (Google Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Backend & Frontend URLs
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
VITE_API_URL="http://localhost:8000"

# Governance Thresholds (INR)
HIGH_RISK_PO_THRESHOLD=10000.0
HIGH_RISK_TRANSFER_QUANTITY=100
CRITICAL_STOCKOUT_DAYS_THRESHOLD=3.0
WARNING_STOCKOUT_DAYS_THRESHOLD=7.0
EXPIRY_WARNING_DAYS=90

# ============================================================
# Automatic Patient Greeting SMS — Provider Configuration
# ============================================================
# After every successful bill, ONE greeting SMS is automatically
# sent to the patient's mobile number. No manual action needed.
#
# Supported providers (set SMS_PROVIDER):
#   twilio        — Twilio Live SMS API (global)
#   fast2sms      — Fast2SMS India Gateway (best for Indian numbers)
#   custom        — Custom HTTP webhook gateway
#   auto          — Auto-detect from available credentials (default)
#
# Leave all blank to run without real SMS (status = NOT_CONFIGURED).
# ============================================================

SMS_PROVIDER="auto"
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_ID="MEDISENT"

# Twilio (recommended for global SMS)
# Get credentials: https://console.twilio.com/
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Fast2SMS (recommended for India, free tier available)
# Get API key: https://www.fast2sms.com/
FAST2SMS_API_KEY=""

# Custom HTTP SMS Gateway webhook URL (optional)
SMS_GATEWAY_URL=""
